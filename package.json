{
  "name": "medv2-exam-analyzer",
  "version": "1.0.0",
  "type": "module",
  "description": "App to analyze blood tests and bioimpedance using OpenRouter LLM",
  "main": "backend/src/server.ts",
  "scripts": {
    "start": "tsx backend/src/server.ts",
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:frontend\"",
    "dev:server": "tsx watch backend/src/server.ts",
    "dev:frontend": "vite --config vite.config.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:bootstrap": "tsx scripts/bootstrap-user.ts",
    "db:reset-password": "tsx scripts/reset-password.ts",
    "db:backfill-biomarkers": "tsx scripts/backfill-biomarkers.ts",
    "db:import-json": "tsx scripts/import-json.ts",
    "typecheck": "npm run typecheck:server && npm run typecheck:frontend",
    "typecheck:server": "tsc --noEmit",
    "typecheck:frontend": "tsc --noEmit -p tsconfig.frontend.json",
    "test": "npm run test:server && npm run test:frontend",
    "test:server": "tsx --test backend/test/*.test.ts",
    "test:frontend": "vitest run --config vite.config.ts",
    "build": "npm run build:server && npm run build:frontend",
    "build:server": "tsc",
    "build:frontend": "vite build --config vite.config.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "better-auth": "^1.6.28",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "multer": "^2.2.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.5",
    "tsx": "^4.15.6",
    "typescript": "^5.4.5",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
