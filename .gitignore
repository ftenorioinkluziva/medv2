# Dependências instaladas localmente
node_modules/

# Artefatos gerados de compilação e cobertura
dist/
coverage/
.nyc_output/
*.tsbuildinfo

# Configurações locais e segredos
.env
.env.*
!.env.example
secrets/
*.pem
*.p12
*.pfx
*.key

# Dados clínicos, credenciais e estado gerado pelo runtime local
data/settings.json
data/profile.json
data/analyses.json
data/documents.json
data/handoff-grants.json
data/operations.json
data/audit-events.json
data/migration-issues.json
data/*.tmp
data/*.bak
data/*.lock

# PDFs enviados e outros arquivos de upload (podem conter PHI)
uploads/*
!uploads/.gitkeep

# Logs e arquivos temporários
*.log
logs/
tmp/
temp/
*.tmp
*.swp
*.swo

# Relatórios e artefatos de testes locais
playwright-report/
test-results/

# Bancos locais acidentais
*.sqlite
*.sqlite3
*.db

# Sistemas operacionais e IDEs
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/

# Logs de gerenciadores de pacotes
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
